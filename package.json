{
  "name": "@blopai/browser-harness",
  "version": "0.1.7",
  "description": "Blop Browser: browser infrastructure for coding agents with controlled tools, persistent sessions, CDP reuse, and optional Camoufox.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "blop-browser": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docker",
    "skills",
    "docs",
    "benchmarks/README.md",
    "benchmarks/result.schema.json",
    "benchmarks/mind2web/README.md",
    "benchmarks/mind2web/PROGRESS.md",
    "README.md",
    "ACCEPTABLE_USE.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "logo.svg",
    "LICENSE"
  ],
  "keywords": [
    "ai-agents",
    "agent-tools",
    "browser-automation",
    "browser-cli",
    "camoufox",
    "claude-code",
    "coding-agents",
    "codex",
    "llm-tools",
    "opencode",
    "playwright",
    "typescript",
    "web-automation",
    "cdp",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blop-oss/blop-browser.git"
  },
  "homepage": "https://github.com/blop-oss/blop-browser#readme",
  "bugs": {
    "url": "https://github.com/blop-oss/blop-browser/issues"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '*.md' 'docs/**/*.md' '.github/**/*.{md,yml,yaml}' 'benchmarks/*.md' 'benchmarks/*.json' 'benchmarks/mind2web/*.md' 'scripts/**/*.mjs' package.json",
    "format:check": "prettier --check '*.md' 'docs/**/*.md' '.github/**/*.{md,yml,yaml}' 'benchmarks/*.md' 'benchmarks/*.json' 'benchmarks/mind2web/*.md' 'scripts/**/*.mjs' package.json",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:comparison": "node scripts/check-comparison-matrix.mjs",
    "check:acceptable-use": "node scripts/check-acceptable-use.mjs",
    "lint": "oxlint src test benchmarks/mind2web scripts --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test test/browser test/session test/benchmarks test/cli",
    "test:browser": "bun test test/browser",
    "test:session": "bun test test/session",
    "test:benchmarks": "bun test test/benchmarks",
    "test:cli": "bun test test/cli",
    "test:benchmark-smoke": "bun test test/benchmarks/mind2web.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "camoufox-js": "0.11.1",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
